{{!
    @template mod_slideshow/player

    Learner-facing slideshow player.

    @copyright 2026 Dixeo

    Classes required for JS:
    * slide, prev, next, currentslide, fontsize, overlay, scantoenrol, qrcode, fullscreen, editslide

    Context variables required for this template:
    * cmid
    * hasslides
    * slides (each item is rendered slide markup in html)
    * slidecount
    * singleslide
    * watermarkurl
    * caneditslides
    * showqr
    * addslideurl
    * previcon
    * nexticon
    * fullscreenicon

    Example context (json):
    {
        "cmid": 1,
        "hasslides": true,
        "slides": [{"html": "<div class=\"slide no-overflow\" data-slideid=\"10\"><p>Hello</p></div>"}],
        "slidecount": 1,
        "singleslide": true,
        "watermarkurl": "https://example.com/theme/image.php/boost/slideshow/1/dixeo",
        "caneditslides": true,
        "showqr": false,
        "addslideurl": "https://example.com/mod/slideshow/edit.php?cm=1",
        "previcon": "<i class=\"icon fa fa-chevron-left\"></i>",
        "nexticon": "<i class=\"icon fa fa-chevron-right\"></i>",
        "fullscreenicon": "<i class=\"icon fa fa-expand\"></i>"
    }
}}
{{#hasslides}}
<div id="slideshow-{{cmid}}" class="box py-3 slideshow-container generalbox center clearfix">
    <div class="overlay hidden">
        <div class="scantoenrol">{{#str}}scantoenrol, slideshow{{/str}}</div>
    </div>
    {{#slides}}
        {{{html}}}
    {{/slides}}
    <div class="watermark">
        <img class="watermark" src="{{watermarkurl}}" alt="{{#str}}watermark, slideshow{{/str}}">
    </div>
    <div class="slidecontrols">{{!
    }}<span class="navbuttons"><span class="prev disabled">{{{previcon}}}</span><span class="next{{#singleslide}} disabled{{/singleslide}}">{{{nexticon}}}</span></span>{{!
    }}<span class="currentslide">1/{{slidecount}}</span>{{!
    }}<div class="controls"><div class="fontsize-control"><div class="fontsize-panel" hidden><button type="button" class="fontsize-step fontsize-minus" aria-label="{{#str}}decrease, slideshow{{/str}}">−</button><input id="fontsize-slider" class="fontsize" type="range" min="70" max="180" step="10" value="100" aria-label="{{#str}}textsize, slideshow{{/str}}"><button type="button" class="fontsize-step fontsize-plus" aria-label="{{#str}}increase, slideshow{{/str}}">+</button></div><button type="button" class="fontsize-toggle" aria-expanded="false" aria-controls="fontsize-slider" aria-label="{{#str}}textsize, slideshow{{/str}}"><span class="fontsize-a fontsize-a-small" aria-hidden="true">A</span><span class="fontsize-a fontsize-a-large" aria-hidden="true">A</span></button></div>{{#showqr}}<span class="qrcode"><i class="icon fa fa-solid fa-qrcode fa-fw" title="{{#str}}qrcode, slideshow{{/str}}" role="img" aria-label="{{#str}}qrcode, slideshow{{/str}}"></i></span>{{/showqr}}<button class="fullscreen" tabindex="0" aria-label="{{#str}}fullscreen, slideshow{{/str}}">{{{fullscreenicon}}}</button></div>{{!
    }}</div>
</div>
{{#caneditslides}}
    <a href="#" class="editslide btn btn-secondary float-right">{{#str}}edit, slideshow{{/str}}</a>
{{/caneditslides}}
{{/hasslides}}
{{^hasslides}}
<div class="box py-3 generalbox slideshow-empty clearfix">
    <p>{{#str}}noslides, slideshow{{/str}}</p>
    {{#caneditslides}}
        <p>{{#str}}noslides_teacherhint, slideshow{{/str}}</p>
        <a href="{{addslideurl}}" class="btn btn-primary">{{#str}}addnew, slideshow{{/str}}</a>
    {{/caneditslides}}
</div>
{{/hasslides}}
